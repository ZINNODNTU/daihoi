# Supabase Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Ít nhất 32 ký tự ngẫu nhiên, giữ bí mật trên Vercel; thay đổi sẽ vô hiệu QR cũ.
QR_HMAC_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_32_CHARS_MINIMUM
# Chỉ được lưu trên máy chủ/Vercel, tuyệt đối KHÔNG thêm NEXT_PUBLIC_
# Server kiểm tra quyền BTC và QR trước khi ghi điểm danh qua khóa này.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Google Drive: dùng OAuth refresh token của tài khoản đã cấp quyền.
# Không đưa các biến này vào NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

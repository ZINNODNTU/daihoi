# Supabase Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Ít nhất 32 ký tự ngẫu nhiên, giữ bí mật trên Vercel; thay đổi sẽ vô hiệu QR cũ.
QR_HMAC_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_32_CHARS_MINIMUM
# Chỉ được lưu trên máy chủ/Vercel, tuyệt đối KHÔNG thêm NEXT_PUBLIC_
# Server kiểm tra quyền BTC và QR trước khi ghi điểm danh qua khóa này.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Google Drive V18 (khuyến nghị): Apps Script làm cầu nối upload.
# Dán scripts/google-drive-bridge/Code.gs vào Apps Script đã triển khai Web App.
# Script Properties: BRIDGE_SECRET (>=32 ký tự), ROOT_FOLDER_ID (thư mục gốc).
# Cùng giá trị BRIDGE_SECRET cấu hình ở GOOGLE_APPS_SCRIPT_SECRET trên máy chủ.
# Nếu 2 biến dưới được khai báo, website tự ưu tiên Apps Script và KHÔNG CẦN OAuth.
# GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# GOOGLE_APPS_SCRIPT_SECRET=YOUR_RANDOM_32_CHAR_OR_LONGER_SECRET
# Phương án OAuth trực tiếp V17 (tùy chọn dự phòng) theo docs/lich-su/tai-lieu/GOOGLE-DRIVE-V17.md.
# Các biến này chỉ dành cho máy chủ; TUYỆT ĐỐI không thêm NEXT_PUBLIC_.
# Thư mục gốc phải thuộc hoặc cấp quyền ghi cho tài khoản OAuth.
# Dùng tài khoản Google Drive riêng cho Đại hội, không công khai file Drive.
# Ứng dụng Google OAuth ở chế độ External/Testing có thể khiến refresh token hết hạn sau 7 ngày.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Tùy chọn: địa chỉ công khai/LAN để đại biểu quét QR từ điện thoại.
# Khi chạy local và máy chủ được mở bằng localhost, hệ thống tự tìm IP LAN.
# SESSION_QR_BASE_URL=http://192.168.1.72:3000
# true only after applying upgrade-attendance-realtime-v19.sql and verifying staff Realtime RLS
NEXT_PUBLIC_ATTENDANCE_REALTIME_ENABLED=false
